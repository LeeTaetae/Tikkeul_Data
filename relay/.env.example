# 복사해서 relay/.env 로 사용한다. .env 는 Git 에 올리지 않는다. 이 파일에는 변수명만 적는다.

# Render 가 보내는 X-Relay-Token 헤더와 같아야 하는 비밀 값. 24자 이상 무작위 문자열.
# 만드는 법: backend/.venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_TOKEN=

# 국가교통정보센터(ITS) 인증키. 이 PC 에서만 쓰고 터널로는 나가지 않는다. backend/.env 와 같은 값이다.
ITS_EVENT_API_KEY=
ITS_CAUTION_API_KEY=
ITS_TRAFFIC_API_KEY=
ITS_PREDICTION_API_KEY=
