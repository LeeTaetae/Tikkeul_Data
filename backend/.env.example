# 복사해서 backend/.env 로 사용한다. .env 는 Git 에 올리지 않는다.
# 이 파일에는 변수명만 적는다. 실제 키는 .env 에만 입력하고, 코드·로그·문서에 노출하지 않는다.
# 키가 하나뿐이면 같은 값을 여러 변수에 넣어도 된다.

# 국가교통정보센터(ITS) OpenAPI 인증키: https://www.its.go.kr/opendata
ITS_TRAFFIC_API_KEY=
ITS_EVENT_API_KEY=
ITS_PREDICTION_API_KEY=
ITS_CAUTION_API_KEY=

# 공공데이터포털 서비스키(경찰청 전국 보호구역 현황): https://www.data.go.kr/data/15142010/openapi.do
PROTECTION_ZONE_SERVICE_KEY=

# Kakao Developers 앱의 REST API 키(좌표 -> 시군구 변환, Kakao Local). 지도용 JavaScript 키와 다른 키다. 서버에서만 쓴다.
KAKAO_REST_API_KEY=

# 국토교통부 TAGO 버스노선정보 인증키(data.go.kr 활용신청 후 발급, 일반 인증키). 없으면 버스 노선/정류장 매칭이 꺼진다. 값은 여기에 쓰지 않는다.
TAGO_SERVICE_KEY=
# 서울특별시 노선정보조회 인증키(data.go.kr 15000193 활용신청 후 발급). 없으면 서울 버스 매칭이 꺼진다(TAGO 는 그대로 동작). 값은 여기에 쓰지 않는다.
SEOUL_BUS_SERVICE_KEY=

# 로그인(JWT) 서명 비밀키. 아무 긴 임의 문자열이나 쓴다(예: openssl rand -hex 32). 없으면 가입/로그인이 503을 낸다.
JWT_SECRET=

# 구글 소셜 로그인 - Google Cloud Console의 OAuth 클라이언트 ID(웹). ID 토큰 검증의 audience로만 쓰는
# 공개 클라이언트 ID이고 비밀값이 아니다(프런트엔드의 EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID와 같은 값).
GOOGLE_WEB_CLIENT_ID=

# 가입 인증메일 발송(Resend, https://resend.com). 없으면 가입은 되지만 인증메일은 조용히 안 보낸다.
RESEND_API_KEY=

# 선택: 인증메일 링크가 가리킬 이 백엔드의 공개 주소(프런트엔드 주소 아님). Render 배포 URL로 설정한다.
# 비우면 http://localhost:8000 - 운영에서 이대로 두면 메일 링크가 로컬 주소를 가리키게 된다.
API_BASE_URL=

# 선택: ITS 중계(relay/). ITS 가 이 서버의 IP 대역에서 연결되지 않을 때만 쓴다. 비워 두면 ITS 로 직접 호출한다.
# 설정하면 ITS 인증키는 중계 PC 에만 있고(이 서버는 보내지 않는다), 토큰은 X-Relay-Token 헤더로 보낸다.
# 주소는 https:// 여야 한다(개발용 http://127.0.0.1, http://localhost 만 예외).
ITS_RELAY_URL=
ITS_RELAY_TOKEN=

# 선택: 프런트엔드(웹) 출처 허용 목록. 쉼표로 구분한다. 비우면 로컬 Expo Web 개발 주소(localhost:8081 등)만 허용한다.
CORS_ALLOW_ORIGINS=

# 내비게이션(경로 탐색, app/navigation). 키가 없으면 해당 경로 요청만 503 을 낸다.
# SK Open API(Tmap) appKey: 자동차 경로와 도보 경로
TMAP_APP_KEY=
# Naver Cloud Maps Directions 키. /navigation/route 에서만 쓰고, 현재 프런트엔드는 호출하지 않는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 자전거·대중교통 경로와 역지오코딩은 위의 KAKAO_REST_API_KEY 를 같이 쓴다.

# NCP Papago 번역(/places/search 자동완성에서 중국어 검색어를 한국어로 바꿔 Kakao 검색에 넘길 때만 쓴다).
# NCP 콘솔 > Application > Papago Translation 으로 새로 발급해야 한다(Maps용 NAVER_CLIENT_ID/SECRET 과 다른 키).
# 키가 없으면 중국어 검색은 그냥 빈 결과로 남는다(기존 동작 유지).
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=
